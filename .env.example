# Flask Application Configuration
# Copy this file to .env and configure your local settings:
#   cp .env.example .env
#
# IMPORTANT: Never commit the actual .env file to version control!

# Secret key used for session signing and CSRF protection
# Generate your own unique key using:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-generate-using-secrets-token-hex

# Flask environment settings
FLASK_DEBUG=false
FLASK_ENV=production
PORT=5000

# Optional model paths (defaults to model.pkl and model1.pkl in project directory)
# MODEL_PATH=model.pkl
# SALARY_MODEL_PATH=model1.pkl